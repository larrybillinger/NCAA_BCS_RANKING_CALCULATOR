# PostgreSQL
POSTGRES_DB=rankings
POSTGRES_USER=rankings
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://rankings:replace-with-a-long-random-password@db:5432/rankings

# Web
WEB_PORT=8765
WEB_TITLE=D1 Rank
TZ=America/Chicago
SEASON=2026
BOOTSTRAP_RANKINGS=true

# Ranking/prediction model
MODEL_VERSION=division_i_weighted_v5
PREDICTOR_VERSION=rank_gap_v3

# Automatic data sync
CFBD_API_KEY=replace-with-your-collegefootballdata-api-key
CFBD_BASE_URL=https://api.collegefootballdata.com

# Simple production cadence:
# - every 60 minutes on Saturday
# - every 24 hours on all other days
# - one full-season schedule refresh at least every 24 hours
SYNC_SATURDAY_MINUTES=60
SYNC_OTHER_DAYS_MINUTES=1440
SYNC_FULL_SCHEDULE_HOURS=24
SYNC_RATE_LIMIT_BASE_MINUTES=360
SYNC_RATE_LIMIT_MAX_MINUTES=1440
